{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@kerith/core": ["./packages/core/src/index.ts"],
      "@kerith/eslint-plugin": ["./packages/eslint-plugin/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist"]
}
