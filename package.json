{
  "name": "kerith-suite",
  "private": true,
  "description": "Kerith Core and its surrounding ecosystem.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:identifiers": "npm run build -w @kerith/identifiers",
    "test": "npm test --workspaces --if-present",
    "test:identifiers": "npm test -w @kerith/identifiers",
    "lint": "eslint \"packages/**/src/**/*.ts\" \"packages/**/tests/**/*.ts\"",
    "lint:fix": "eslint \"packages/**/src/**/*.ts\" \"packages/**/tests/**/*.ts\" --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bench": "npm run bench -w @kerith/core",
    "bench:scaling": "npm run bench:scaling -w @kerith/core"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.2.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.2"
  }
}
