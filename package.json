{
  "name": "kerith-suite",
  "private": true,
  "description": "Kerith Core and its surrounding ecosystem.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kerith/core build && pnpm --filter @kerith/identifiers build && pnpm --filter @kerith/eslint-plugin build && pnpm --filter @kerith/app build && pnpm --filter create-kerith build",
    "build:identifiers": "pnpm --filter @kerith/identifiers build",
    "build:app": "pnpm --filter @kerith/app build",
    "build:create-kerith": "pnpm --filter create-kerith build",
    "test": "pnpm -r test",
    "test:identifiers": "pnpm --filter @kerith/identifiers test",
    "test:app": "pnpm --filter @kerith/app test",
    "test:create-kerith": "pnpm --filter create-kerith test",
    "lint": "eslint \"packages/**/src/**/*.ts\" \"packages/**/tests/**/*.ts\"",
    "lint:fix": "eslint \"packages/**/src/**/*.ts\" \"packages/**/tests/**/*.ts\" --fix",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "bench": "pnpm --filter @kerith/core bench",
    "bench:scaling": "pnpm --filter @kerith/core bench:scaling"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.2.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
