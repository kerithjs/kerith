{
  "name": "@kerith/eslint-plugin",
  "version": "2.0.0-alpha.1",
  "description": "ESLint plugin for Kerith architecture validation.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kerith",
    "eslint",
    "eslint-plugin"
  ],
  "author": "Vlynk Studios & Keiver-dev",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kerithjs/kerith",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/kerithjs/kerith/issues"
  },
  "homepage": "https://github.com/kerithjs/kerith/tree/main/packages/eslint-plugin#readme",
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.58.1",
    "eslint": "10.2.0",
    "tsup": "8.5.1",
    "typescript": "5.4.5",
    "vitest": "4.1.2"
  },
  "dependencies": {
    "acorn": "8.16.0",
    "acorn-walk": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
