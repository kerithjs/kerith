{
  "extends": "./tsconfig.kerith.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@config": [
        "./src/config"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@config/*.js": [
        "./src/config/*.ts"
      ],
      "@middleware": [
        "./src/middleware"
      ],
      "@middleware/*": [
        "./src/middleware/*"
      ],
      "@middleware/*.js": [
        "./src/middleware/*.ts"
      ],
      "@modules/auth": [
        "./src/modules/auth/index.ts"
      ],
      "@modules/auth/*": [
        "./src/modules/auth/*"
      ],
      "@modules/core": [
        "./src/modules/core/index.ts"
      ],
      "@modules/core/*": [
        "./src/modules/core/*"
      ],
      "@modules/notifications": [
        "./src/modules/notifications/index.ts"
      ],
      "@modules/notifications/*": [
        "./src/modules/notifications/*"
      ],
      "@modules/users": [
        "./src/modules/users/index.ts"
      ],
      "@modules/users/*": [
        "./src/modules/users/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../../src/**/*.ts"
  ]
}
