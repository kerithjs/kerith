{
  "name": "@kerith/identifiers",
  "version": "1.0.0-alpha.1",
  "description": "Extended identifier catalog for the Kerith framework.",
  "author": "Vlynk Studios & Keiver-dev",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kerithjs/kerith"
  },
  "keywords": [
    "kerith",
    "identifiers",
    "esm",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/kerithjs/kerith/issues"
  },
  "homepage": "https://kerith.dev",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@kerith/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "8.5.1",
    "typescript": "5.4.5",
    "vitest": "4.1.2"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  }
}
