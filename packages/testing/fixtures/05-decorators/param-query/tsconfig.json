{
  "extends": "./tsconfig.kerith.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@modules/health": [
        "./src/modules/health/index.ts"
      ],
      "@modules/health/*": [
        "./src/modules/health/*"
      ],
      "@modules/items": [
        "./src/modules/items/index.ts"
      ],
      "@modules/items/*": [
        "./src/modules/items/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
